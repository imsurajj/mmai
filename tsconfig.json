{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["./components/ui/*", "./src/components/ui/*"],
      "@/components/charts/*": ["./components/charts/*"],
      "@/theme/*": ["./theme/*"],
      "@/providers/*": ["./providers/*"],
      "@/hooks/*": ["./hooks/*", "./src/hooks/*"],
      "@/assets/*": ["./assets/*"],
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "rootDir": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "providers/**/*.ts",
    "providers/**/*.tsx",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules/*"],
  "watchOptions": {
    "excludeDirectories": ["**/node_modules"]
  }
}
