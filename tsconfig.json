{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/components/ui/*": [
        "./components/ui/*"
      ],
      "@/components/charts/*": [
        "./components/charts/*"
      ],
      "@/theme/*": [
        "./theme/*"
      ],
      "@/providers/*": [
        "./providers/*"
      ],
      "@/hooks/*": [
        "./hooks/*",
        "./src/hooks/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
