# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Expo App Compatible Variables
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase Service Role Key (Keep secret, backend/server only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend API Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EXPO_PUBLIC_RESEND_API_KEY=re_your_resend_api_key_here
NEXT_PUBLIC_RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
EXPO_PUBLIC_RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Gemini API Configuration (for Dynamic Cognitive Questions)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Agents Configuration (public agent identifier only)
EXPO_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

